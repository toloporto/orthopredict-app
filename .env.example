# orthopredict_app/.env.example
# Configuración de la aplicación
ORTHOPREDICT_DEBUG=false
ORTHOPREDICT_APP_VERSION=5.2

# Configuración de rutas
ORTHOPREDICT_DATA_DIR=./data
ORTHOPREDICT_MODELS_DIR=./models
ORTHOPREDICT_LOGS_DIR=./logs
ORTHOPREDICT_BACKUP_DIR=./backups

# Configuración ML
ORTHOPREDICT_ML_CACHE_SIZE=100
ORTHOPREDICT_ML_PREDICTION_TIMEOUT=30
ORTHOPREDICT_ML_TRAINING_SAMPLES=2000

# ✅ NUEVO: Configuración de datos clínicos
ORTHOPREDICT_CLINICAL_DATA_ENABLED=true
ORTHOPREDICT_CLINICAL_DATASET_SIZE=2000
ORTHOPREDICT_ANALYTICS_ENABLED=true
ORTHOPREDICT_CLINICAL_REPORT_RETENTION=90
ORTHOPREDICT_AUTO_CLINICAL_ANALYSIS=true

# Configuración de monitoreo
ORTHOPREDICT_MONITORING_ENABLED=true
ORTHOPREDICT_MONITORING_INTERVAL=3600
ORTHOPREDICT_ALERT_THRESHOLD=0.7

# Configuración de cache
ORTHOPREDICT_CACHE_ENABLED=true
ORTHOPREDICT_CACHE_TTL=3600
ORTHOPREDICT_CACHE_MAX_SIZE=1000

# Configuración de reportes
ORTHOPREDICT_REPORT_FORMATS=pdf,excel,csv
ORTHOPREDICT_REPORT_RETENTION_DAYS=30

# Configuración de seguridad
ORTHOPREDICT_SESSION_TIMEOUT=3600
ORTHOPREDICT_MAX_LOGIN_ATTEMPTS=5